# ============================================================
# OpenWeatherMap — used ONLY by the server-side weather proxy
# (functions/api/weather.js), never by frontend code.
#
# Cloudflare Pages: set OPENWEATHER_API_KEY as an environment
# variable / secret in the Pages project dashboard
# (Settings > Environment variables), or locally in a
# `.dev.vars` file which is git-ignored.
#
# This file contains placeholders ONLY — never put a real key here.
# ============================================================

OPENWEATHER_API_KEY=your_openweather_api_key_here
